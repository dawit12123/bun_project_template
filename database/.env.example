# Default database: every schema lives here (shared DB, cross-schema foreign keys allowed).
DATABASE_URL=postgres://driversim:driversim@localhost:5433/driversim

# Optional: move one schema to its own database. Foreign keys cannot cross databases;
# `bun run db:migrate` refuses to run if a migration references a schema in another database.
# DATABASE_URL__STUDENT_SERVICE=postgres://driversim:driversim@localhost:5433/student_service

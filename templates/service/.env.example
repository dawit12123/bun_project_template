# ──────────────────────────────────────────────────────────────────────────────
# service-template — settings specific to THIS service.
# Shared settings (DATABASE_URL, REDIS_URL, KAFKA_BROKERS, AUTH_*, LOG_*, …) come from the
# repository root .env. Any of them can be overridden here for this service only.
# ──────────────────────────────────────────────────────────────────────────────

SERVICE_NAME=service-template
SERVICE_VERSION=0.1.0
PORT=4000

# Schema owned by this service in the shared database (search_path)
DATABASE_SCHEMA=service_template
# Other schemas (same database) readable without qualification, e.g. auth_service
DATABASE_EXTRA_SCHEMAS=

# Inline JWKS for local work without a running auth-service (ignored when AUTH_JWKS_URL is set).
# AUTH_JWKS_URL=
# AUTH_JWKS_JSON={"keys":[]}

# Optional overrides (defaults shown)
# RATE_LIMIT_PER_MINUTE=300
# BODY_LIMIT_BYTES=1048576
# SHUTDOWN_TIMEOUT_MS=15000
# OUTBOX_POLL_INTERVAL_MS=1000
# KAFKA_CONSUMER_ENABLED=true
# REDIS_KEY_PREFIX=service-template:

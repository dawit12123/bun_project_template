# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=service-template
SERVICE_VERSION=0.1.0
SHUTDOWN_TIMEOUT_MS=15000

# ── HTTP ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false
BODY_LIMIT_BYTES=1048576
API_DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300

# ── PostgreSQL: one shared database, one schema per service ───────────────────
# (leave DATABASE_URL empty to run on in-memory adapters; required in production)
DATABASE_URL=postgres://driversim:driversim@localhost:5433/driversim
# Defaults to SERVICE_NAME in snake_case; connections use search_path=<schema>
DATABASE_SCHEMA=service_template
# Other schemas (same database) readable without qualification, e.g. auth_service,school_service
DATABASE_EXTRA_SCHEMAS=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_S=30
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_MAX_LIFETIME_S=1800
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── Redis (leave empty for in-memory; required in production) ───────────────────
REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX defaults to "<SERVICE_NAME>:"
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=5000

# ── Redpanda / Kafka (leave empty for the in-memory bus; required in production) ─
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=
KAFKA_CONSUMER_GROUP=
KAFKA_CONSUMER_ENABLED=true
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Outbox relay ──────────────────────────────────────────────────────────────
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETENTION_HOURS=72

# ── Auth (tokens issued by auth-service) ────────────────────────────────────────
AUTH_ISSUER=driversim-auth
AUTH_AUDIENCE=driversim-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Inline JWKS for local work without auth-service (ignored when AUTH_JWKS_URL is set)
AUTH_JWKS_JSON=
AUTH_CLOCK_TOLERANCE_S=5

# ── Logging & metrics ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true
METRICS_DEFAULT_COLLECTORS=true

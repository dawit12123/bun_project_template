{
  "name": "@driversim/service-template",
  "version": "0.1.0",
  "private": true,
  "description": "Hexagonal DDD microservice template for the DriverSim platform (Bun + TypeScript + Hono).",
  "type": "module",
  "engines": {
    "bun": ">=1.2.21"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:http": "bun test tests/http",
    "test:integration": "bun test tests/integration",
    "check": "bun run typecheck && bun run lint && bun test",
    "db:seed": "bun scripts/seed.ts",
    "openapi:export": "bun scripts/export-openapi.ts"
  },
  "dependencies": {
    "@driversim/auth": "workspace:*",
    "@driversim/bootstrap": "workspace:*",
    "@driversim/core": "workspace:*",
    "@driversim/http": "workspace:*",
    "@driversim/messaging": "workspace:*",
    "@driversim/observability": "workspace:*",
    "@driversim/postgres": "workspace:*",
    "@driversim/redis": "workspace:*",
    "@hono/zod-openapi": "0.18.4",
    "hono": "4.6.20",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@driversim/testing": "workspace:*",
    "@types/bun": "1.2.21",
    "typescript": "5.7.3",
    "jose": "5.9.6"
  }
}

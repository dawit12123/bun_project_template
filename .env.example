# ──────────────────────────────────────────────────────────────────────────────
# Shared settings for EVERY service and for the migrator (copy to .env: `bun run setup`).
# Load order: this file → services/<name>/.env (service values override these) → real env.
# Service-specific settings (SERVICE_NAME, PORT, DATABASE_SCHEMA, secrets) live in the
# service's own .env.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── PostgreSQL: one shared database, one schema per service ───────────────────
# Leave empty to run services on in-memory adapters (not auth-service; never in production).
DATABASE_URL=postgres://driversim:driversim@localhost:5433/driversim
# Optional: move one schema to its own database (migrator + that service). FKs cannot cross DBs.
# DATABASE_URL__STUDENT_SERVICE=postgres://driversim:driversim@localhost:5433/student_service
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── Redis (leave empty for in-memory; required in production) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Redpanda / Kafka (leave empty for the in-memory bus; required in production) ─
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Tokens issued by auth-service (every service verifies them) ─────────────────
AUTH_ISSUER=driversim-auth
AUTH_AUDIENCE=driversim-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_CLOCK_TOLERANCE_S=5

# ── HTTP defaults ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
API_DOCS_ENABLED=true

# ── Logging & metrics ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true

# ── Tests (integration suites reset this database: the name must end with _test) ──
TEST_DATABASE_URL=postgres://driversim:driversim@localhost:5433/driversim_test
